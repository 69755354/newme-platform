# Install as /etc/newme/backup.env (root:root, chmod 600). No secrets belong in
# this file: it only names where the secrets live.
NEWME_DB_URL_FILE=/etc/newme/migration-db.url
# The migration connection string uses sslmode=verify-full but carries no sslrootcert, so libpq
# needs the Supabase root certificate from the environment (otherwise pg_dump cannot verify the server).
export PGSSLROOTCERT=/etc/newme/supabase-root-2021.crt
BACKUP_KEY_FILE=/etc/newme/backup-encryption.key
BACKUP_DIR=/var/backups/newme-db
RETENTION_DAYS=30
KEEP_MIN=7
# Backups sit in /var/backups/newme-db (root:root 0700), never under /root (ProtectHome hides it).
# NAS: the NAS PULLS (rsync over ssh, read-only account, see newme-nas-pull-setup.sh); the server holds
# no NAS credentials. After each backup an encrypted copy is placed in PULL_EXPORT_DIR (root:newme-nas-pull
# 0750, files 0640) if that directory exists. The old push settings below are deprecated; leave empty.
PULL_EXPORT_DIR=/var/backups/newme-db-pull
PULL_EXPORT_GROUP=newme-nas-pull
# Set to 1 once the NAS has been configured: the hourly freshness check then alerts when the NAS has
# not completed a pull for NAS_PULL_MAX_AGE_HOURS (default 30).
# NAS_PULL_REQUIRED=1
# NAS_PULL_MAX_AGE_HOURS=30
SYNC_TARGET=
SYNC_SSH_KEY=
# NAS push (newme-nas-push.timer): once /var/lib/newme-nas-push exists, the hourly freshness check alerts
# (key nas-push-freshness) when last-ok is older than NAS_PUSH_MAX_AGE_HOURS (default 26) or missing.
# NAS_PUSH_MAX_AGE_HOURS=26
# Restore drill: weekly (newme-restore-drill.timer), restores into a throwaway local PostgreSQL 17 (Unix socket only).
# Needs the PostgreSQL 17 SERVER programs (initdb, pg_ctl); see docs/runbooks/s17-ops-readiness.md section 4.
# The freshness check requires a pass at most DRILL_MAX_DAYS (default 9) old; a missing pass stamp is a failure
# from DRILL_REQUIRED_FROM (default 2026-12-01) on, or at once with DRILL_REQUIRED=1.
# DRILL_MAX_DAYS=9
# DRILL_REQUIRED_FROM=2026-12-01
# DRILL_REQUIRED=1
