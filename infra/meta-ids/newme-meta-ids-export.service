[Unit]
Description=NewMe Meta ID registry: daily CSV fetch and NAS upload
After=network-online.target
Wants=network-online.target
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/newme/newme-meta-ids-export.sh
Nice=10
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# /etc/newme (token and NAS account) stays readable under ProtectSystem=strict; the only writable place is the output folder.
ProtectSystem=strict
ReadWritePaths=/var/lib/newme-meta-ids
StateDirectory=newme-meta-ids
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
