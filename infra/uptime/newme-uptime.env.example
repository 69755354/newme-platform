# Copy to /etc/newme-uptime.env on the NAS (or other off-server host), chmod 600.
# Real values are never committed.
NEWME_BASE_URL=https://app.newme.ae
# Default alert channel is WhatsApp via newme-whatsapp-alert.sh (ALERT_SENDER, own env file).
# Telegram is optional: set ALERT_CHANNEL=telegram and fill both lines below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FAIL_THRESHOLD=2
STATE_DIR=/var/lib/newme-uptime
DAILY_HEARTBEAT_HOUR_UTC=3
