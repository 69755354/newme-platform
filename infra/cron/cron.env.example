# Install as /etc/newme/cron.env (root:root, mode 600). Real values are never committed.
# Create it WITHOUT printing the secret, copying only that one line from the application's env:
# CRON_SECRET is kept in the application's env file /opt/newme/current/.env.local (not in
# /etc/newme/newme-runtime.env). The application listens on port 3001.
#   ( umask 077; grep '^CRON_SECRET=' /opt/newme/current/.env.local > /etc/newme/cron.env )
#   echo 'NEWME_CRON_BASE_URL=http://127.0.0.1:3001' >> /etc/newme/cron.env
CRON_SECRET=
NEWME_CRON_BASE_URL=http://127.0.0.1:3001
