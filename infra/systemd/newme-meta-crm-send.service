[Unit]
Description=NewMe send queued lead-form CRM stage events (meta_crm_stage_events) to the Meta Conversions API
After=network-online.target
Wants=network-online.target
OnFailure=newme-unit-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/newme/newme-runtime.env
EnvironmentFile=/etc/newme/capi-wa.env
WorkingDirectory=/opt/newme/current
ExecStart=/usr/bin/node scripts/meta-crm-events-send.mjs --execute
TimeoutStartSec=120
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
