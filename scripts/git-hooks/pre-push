#!/usr/bin/env bash
# Git pre-push hook: blocks push if taskboard has failures
# Install: cp scripts/git-hooks/pre-push .git/hooks/pre-push

set -o pipefail

echo "=== 🔒 Pre-push: Taskboard gate ==="

if [ -f "scripts/check-taskboard.sh" ]; then
  bash scripts/check-taskboard.sh
  if [ $? -ne 0 ]; then
    echo ""
    echo "🚫 PUSH BLOCKED: Taskboard verification failed."
    echo "   Complete all ❌ items in TASKBOARD.md before pushing."
    echo "   To bypass (emergency only): git push --no-verify"
    exit 1
  fi
else
  echo "⚠️  scripts/check-taskboard.sh not found"
fi

echo "✅ Taskboard gate passed"
exit 0
