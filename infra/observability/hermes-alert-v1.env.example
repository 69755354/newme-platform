# Install as /etc/hermes/observability/hermes-alert-v1.env.
# This file contains no secrets. The installed state machine pins the versioned
# notifier and provider transport; only state and threshold policy live here.
HERMES_ALERT_STATE_DIR=/var/lib/newme/hermes-alert-v1/production
HERMES_ALERT_THRESHOLD=2
HERMES_L0_ALERT_THRESHOLD=1
