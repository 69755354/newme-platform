[Unit]
Description=NewMe OS to Google Sheets and NAS incremental push (Meta IDs sheet, Home-owners column X)
# STATUS: after-flag. Does nothing unless OS_DRIVE_SYNC_ENABLED=true in /etc/newme/os-drive-sync.env.
After=network-online.target
Wants=network-online.target
# The worker exits non-zero only on a hard failure (read-back mismatch, cap exceeded, header changed) or from the
# 3rd consecutive soft failure on, so this alert is not sent for every failed 5-minute run.
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/newme/current
EnvironmentFile=/etc/newme/newme-runtime.env
EnvironmentFile=-/etc/newme/os-drive-sync.env
Environment=GOOGLE_SA_FILE=/etc/newme/google-sheets-sa.json
# flock: one run at a time (the lock lives in the state directory; /run is read-only under ProtectSystem=strict)
ExecStart=/usr/bin/flock -n -E 0 /var/lib/newme-os-drive-sync/run.lock /usr/bin/node scripts/os-drive-nas-sync.mjs
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/newme-os-drive-sync
StateDirectory=newme-os-drive-sync
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Nice=10
