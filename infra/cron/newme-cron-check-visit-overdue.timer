[Unit]
Description=NewMe scheduled call /api/cron/check-visit-overdue (09:45 Asia/Dubai)
# STATUS: after-flag
# install only together with VISIT_OVERDUE_ALERTS_ENABLED=true

[Timer]
OnCalendar=*-*-* 09:45:00 Asia/Dubai
RandomizedDelaySec=60
Persistent=true
Unit=newme-cron@check-visit-overdue.service

[Install]
WantedBy=timers.target
