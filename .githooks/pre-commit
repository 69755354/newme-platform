#!/bin/bash
# 🔴 PRE-COMMIT HOOK — Coding Auth Gate
# Blocks commits that modify code files without valid auth token.
# Auth tokens are issued by Hermes when delegating to OpenCode/Codex.
# Token format: .hermes/state/coding-auth.json {session_id, expires_at, tool}
set -e

HOOK_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
MANIFEST="$HOOK_DIR/manifest.json"
AUTH_FILE="$REPO_ROOT/.hermes/state/coding-auth.json"

MY_HASH=$(sha256sum "$0" | cut -d' ' -f1)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# ── Self-integrity ──
STORED_HASH=$(python3 -c "import json;print(json.load(open('$MANIFEST'))['hooks']['pre-commit'])" 2>/dev/null || echo "")
if [ -n "$STORED_HASH" ] && [ "$MY_HASH" != "$STORED_HASH" ]; then
    echo -e "${RED}🔴 PRE-COMMIT HOOK TAMPERED — Run 'scripts/install-hooks.sh --force'${NC}"
    exit 1
fi

# ── Find staged code files ──
STAGED_CODE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|py|css|scss|less)$' || true)

if [ -z "$STAGED_CODE" ]; then
    echo "✅ No code files staged — gate bypassed"
    exit 0
fi

echo "═══════════════════════════════════════════"
echo "  🔴 Coding Auth Gate — $(date '+%Y-%m-%d %H:%M:%S')"
echo "═══════════════════════════════════════════"
echo "📄 Staged code files:"
echo "$STAGED_CODE" | sed 's/^/   /'

# ── Check coding auth token ──
AUTH_VALID=false
AUTH_TOOL="unknown"

if [ -f "$AUTH_FILE" ]; then
    EXPIRES=$(python3 -c "
import json, time
try:
    d = json.load(open('$AUTH_FILE'))
    print(d.get('expires_at', 0))
except: print(0)
" 2>/dev/null || echo "0")
    
    NOW=$(date +%s)
    if [ "$NOW" -lt "$EXPIRES" ] 2>/dev/null; then
        AUTH_VALID=true
        AUTH_TOOL=$(python3 -c "import json;print(json.load(open('$AUTH_FILE')).get('tool','unknown'))" 2>/dev/null || echo "unknown")
    fi
fi

if [ "$AUTH_VALID" = false ]; then
    echo ""
    echo -e "${RED}❌  CODING AUTH REQUIRED${NC}"
    echo -e "${RED}   代码修改必须通过 OpenCode 或 Codex 进行，并由 Hermes 签发 auth token。${NC}"
    echo -e "${RED}   ${NC}"
    echo -e "${RED}   流程: 用户在 Hermes 发起任务 → Hermes 签发 token → OpenCode/Codex 写码${NC}"
    echo -e "${RED}   Token 文件: .hermes/state/coding-auth.json${NC}"
    echo -e "${RED}   ${NC}"
    echo -e "${YELLOW}   如果你确认这是手工紧急修复：${NC}"
    echo -e "${YELLOW}     python3 scripts/issue-coding-auth.py --tool manual --reason \"...\"${NC}"
    echo ""
    echo "Staged code files (not committed):"
    echo "$STAGED_CODE" | sed 's/^/   • /'
    echo ""
    exit 1
fi

echo -e "${GREEN}✅ Coding auth valid (tool: $AUTH_TOOL, expires: $(date -d @$EXPIRES '+%H:%M'))${NC}"
exit 0
