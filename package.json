{
  "name": "newme-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "prebuild": "bash scripts/guard-prod-build.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh",
    "check:schema-refs": "python3 scripts/check-schema-refs.py",
    "check:route-files": "bash scripts/check-route-files.sh",
    "check:smoke": "bash scripts/check-smoke.sh",
    "check:logs": "bash scripts/check-logs.sh",
    "check:release": "npm run check:schema-refs && npm run check:route-files && npm run check:smoke && npm run check:logs",
    "test": "node --test tests/**/*.test.mjs",
    "check:supabase-boundaries": "node scripts/check-supabase-boundaries.mjs",
    "check:definer-rpc-allowlist": "node scripts/check-security-definer-rpc-allowlist.mjs",
    "check:db-static": "node scripts/check-db-static.mjs",
    "check:security": "npm run check:supabase-boundaries && npm run check:definer-rpc-allowlist && npm run check:db-static && npm run check:e2e-secrets",
    "check:workflows": "bash scripts/check-workflows-yaml.sh",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "lint:baseline:negative": "node tests/lint-baseline-negative.test.mjs",
    "generate:database-types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > src/types/database.ts && node scripts/check-database-types.mjs --stamp",
    "check:database-types": "node scripts/check-database-types.mjs",
    "check:e2e-secrets": "node scripts/check-e2e-secrets.mjs",
    "check:supply-chain": "bash scripts/check-supply-chain.sh",
    "check:pre-release": "bash scripts/check-pre-release.sh",
    "check:staging-boundaries": "bash scripts/check-staging-boundaries.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-js": "^1.386.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=10.0.0"
  }
}
