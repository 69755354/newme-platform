# Install as /etc/newme/backup.env (root:root, chmod 600). No secrets belong in
# this file: it only names where the secrets live.
NEWME_DB_URL_FILE=/etc/newme/migration-db.url
BACKUP_KEY_FILE=/etc/newme/backup-encryption.key
BACKUP_DIR=/root/claude-ops-backups/db-daily
RETENTION_DAYS=30
KEEP_MIN=7
# Company NAS over Tailscale (leave empty until the NAS is ready), e.g.
#   SYNC_TARGET=backup-user@nas-name.tailnet-name.ts.net:/volume1/newme-backups
#   SYNC_SSH_KEY=/etc/newme/nas-backup-ssh-key
SYNC_TARGET=
SYNC_SSH_KEY=
# Restore drill: restores into a throwaway local PostgreSQL 17 (Unix socket only).
# Needs: apt install postgresql-17 (no cluster is created or started).
# Set to 1 once the monthly drill is enabled: the hourly freshness check then also
# alerts when no drill has passed for 35 days.
# DRILL_REQUIRED=1
