{
  "name": "newme-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "check:taskboard": "node scripts/check-taskboard.mjs",
    "check:taskboard:complete": "node scripts/check-taskboard.mjs --require-complete",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "prebuild": "node scripts/guard-prod-build.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh",
    "check:schema-refs": "python3 scripts/check-schema-refs.py",
    "check:route-files": "node scripts/run-bash.mjs scripts/check-route-files.sh",
    "check:smoke": "node scripts/run-bash.mjs scripts/check-smoke.sh",
    "check:logs": "node scripts/run-bash.mjs scripts/check-logs.sh",
    "check:release": "npm run check:schema-refs && npm run check:route-files && npm run check:smoke && npm run check:logs",
    "test": "node scripts/run-node-tests.mjs",
    "check:supabase-boundaries": "node scripts/check-supabase-boundaries.mjs",
    "check:definer-rpc-allowlist": "node --test tests/security/sam61-definer-boundaries.test.mjs tests/security/sam62-transition-definer-search-path.test.mjs",
    "check:db-static": "node scripts/check-db-static.mjs",
    "check:sam20-database": "node scripts/run-sam20-database-gate.mjs",
    "check:sam23-database": "node scripts/run-sam23-database-gate.mjs",
    "check:sam61-active-profile-database": "node scripts/run-sam61-active-profile-database-gate.mjs",
    "check:security": "npm run check:supabase-boundaries && npm run check:definer-rpc-allowlist && npm run check:db-static && npm run check:e2e-secrets && npm run check:e2e-artifacts",
    "check:workflows": "node scripts/check-workflows-yaml.mjs",
    "lint:baseline": "node scripts/check-lint-baseline.mjs",
    "lint:baseline:negative": "node tests/lint-baseline-negative.test.mjs",
    "generate:database-types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > src/types/database.ts && node scripts/check-database-types.mjs --stamp",
    "check:database-types": "node scripts/check-database-types.mjs",
    "check:migration-history": "node scripts/check-migration-history.mjs",
    "check:e2e-secrets": "node scripts/check-e2e-secrets.mjs",
    "check:e2e-artifacts": "node scripts/check-e2e-artifact-isolation.mjs",
    "check:supply-chain": "node scripts/check-supply-chain.mjs",
    "check:pre-release": "node scripts/run-bash.mjs scripts/check-pre-release.sh",
    "check:staging-boundaries": "node scripts/run-bash.mjs scripts/check-staging-boundaries.sh",
    "verify:sam66:local": "node scripts/verify-local-sam66-auth-regression.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-js": "^1.386.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^5.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "js-yaml": "4.3.1",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "minimatch": "10.2.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  }
}
