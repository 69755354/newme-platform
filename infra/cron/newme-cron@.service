[Unit]
Description=NewMe scheduled call to /api/cron/%i
After=network-online.target newme-platform.service
Wants=network-online.target
OnFailure=newme-unit-alert@%p-%i.service

[Service]
Type=oneshot
User=root
# Only CRON_SECRET and NEWME_CRON_BASE_URL live here (root:root 0600); the application's own
# runtime env, with its database service keys, is deliberately not read. systemd reads this file
# before the sandbox is built, and /etc stays readable under ProtectSystem=strict.
EnvironmentFile=/etc/newme/cron.env
ExecStart=/usr/local/libexec/newme/newme-cron-call.sh %i
TimeoutStartSec=180
Nice=10
UMask=0077
# Sandbox. ReadWritePaths is the alert state/log directory only (the "-" keeps the unit startable
# before the first alert creates it). Nothing here lives under /home or /root, which ProtectHome hides.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=-/var/lib/newme-alerts
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
