# /etc/newme/drive-sync.env  (0640 root:claude-ops). Copy of infra/drive-sync/drive-sync.env.example. Never commit real values.
# The same token must be set in the app runtime environment (/etc/newme/newme-runtime.env).
DRIVE_SYNC_INGEST_TOKEN=
# dry-run (default, plan + report only) | apply (writes through the OS endpoint)
DRIVE_SYNC_MODE=dry-run
DRIVE_SYNC_ENDPOINT=http://127.0.0.1:3001/api/sync/drive-ingest
DRIVE_SYNC_DATA_DIR=/var/lib/newme/drive-sync
DRIVE_SYNC_MAX_WRITES=300
GOOGLE_SA_FILE=/home/claude-ops/.config/newme/google-sheets-sa.json

# --- app side (newme-runtime.env), all default to the safe value ---
# DRIVE_SYNC_INGEST_ENABLED=false     # the route answers 503 until this is true
# DRIVE_SYNC_ALLOW_INSERT=false       # true lets the sync create leads that exist only in Drive
# DRIVE_SYNC_ALLOW_UNARCHIVE=false    # true lets a matched row bring an archived lead back
# DRIVE_SYNC_WRITE_NEXT_DATE=false    # true writes the next follow-up date to the lead (the lead trigger then creates tasks)
# DRIVE_SYNC_MAX_CHANGES_PER_CALL=100
