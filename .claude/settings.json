{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 500000,
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact-archive.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-compact-reconcile.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
