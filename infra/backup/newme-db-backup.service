[Unit]
Description=NewMe encrypted production database backup
After=network-online.target
Wants=network-online.target
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/newme/newme-db-backup.sh
Environment=BACKUP_LIB=/usr/local/libexec/newme/newme-backup-lib.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# The backup directory lives under /var/backups, not /root: ProtectHome=true hides /root, /home and
# /run/user, and a ReadWritePaths entry there cannot bring them back (S7 review, Codex P1).
# ProtectSystem=strict makes everything else read-only; these are the only writable places. The "-"
# entries may be missing until the NAS pull account and the first alert exist.
ProtectSystem=strict
ReadWritePaths=/var/backups/newme-db -/var/backups/newme-db-pull -/var/lib/newme-alerts
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
