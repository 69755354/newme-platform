# Install as /etc/newme/backup.env (root:root, chmod 600). No secrets belong in
# this file: it only names where the secrets live.
NEWME_DB_URL_FILE=/etc/newme/migration-db.url
BACKUP_KEY_FILE=/etc/newme/backup-encryption.key
BACKUP_DIR=/var/backups/newme-db
RETENTION_DAYS=30
KEEP_MIN=7
# Backups sit in /var/backups/newme-db (root:root 0700), never under /root (ProtectHome hides it).
# NAS: the NAS PULLS (rsync over ssh, read-only account, see newme-nas-pull-setup.sh); the server holds
# no NAS credentials. After each backup an encrypted copy is placed in PULL_EXPORT_DIR (root:newme-nas-pull
# 0750, files 0640) if that directory exists. The old push settings below are deprecated; leave empty.
PULL_EXPORT_DIR=/var/backups/newme-db-pull
PULL_EXPORT_GROUP=newme-nas-pull
# Set to 1 once the NAS has been configured: the hourly freshness check then alerts when the NAS has
# not completed a pull for NAS_PULL_MAX_AGE_HOURS (default 30).
# NAS_PULL_REQUIRED=1
# NAS_PULL_MAX_AGE_HOURS=30
SYNC_TARGET=
SYNC_SSH_KEY=
# Restore drill: restores into a throwaway local PostgreSQL 17 (Unix socket only).
# Needs: apt install postgresql-17 (no cluster is created or started).
# Set to 1 once the monthly drill is enabled: the hourly freshness check then also
# alerts when no drill has passed for 35 days.
# DRILL_REQUIRED=1
