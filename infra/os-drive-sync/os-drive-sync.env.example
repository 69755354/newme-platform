# Install as /etc/newme/os-drive-sync.env (root:root, chmod 600). Supabase settings come from newme-runtime.env.
# The Google service account key is /etc/newme/google-sheets-sa.json (root 0600); never commit it.
# Default off: nothing is written to any sheet or the NAS until this is true.
OS_DRIVE_SYNC_ENABLED=false
# OS_DRIVE_MAX_REQUESTS=40
# OS_DRIVE_NAS_CHANGES_DIR=/newme-os-backup/exports/changes
# OS_DRIVE_SYNC_DATA_DIR=/var/lib/newme-os-drive-sync
# META_IDS_OUT_DIR=/var/lib/newme-meta-ids
# NAS_UPLOAD_SCRIPT=/usr/local/libexec/newme/newme-nas-upload.sh

# New OS leads -> sales "Lead Register" (append-only). Default off. Needs the service account to be Editor on the allocation file.
# First run with this on sets the start watermark: only leads created after that moment are ever appended.
# OS_DRIVE_REGISTER_APPEND_ENABLED=true
