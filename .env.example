NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY — set in production env, not in .env.local
# META_PIXEL_ID, META_CAPI_ACCESS_TOKEN, and META_GRAPH_API_VERSION are
# required server-only production runtime settings managed in /etc/newme.
# WhatsApp observer is opt-in and disabled by default. See docs/whatsapp-pilot.md.
WHATSAPP_PILOT_ENABLED=false
# Server-only secrets: WHATSAPP_APP_SECRET, WHATSAPP_WEBHOOK_VERIFY_TOKEN,
# WHATSAPP_PILOT_CONTACT_SALT. Never put their values in this example file.
