[Unit]
Description=NewMe encrypted production database backup
After=network-online.target
Wants=network-online.target
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/newme/newme-db-backup.sh
Environment=BACKUP_LIB=/usr/local/libexec/newme/newme-backup-lib.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1800
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/root/claude-ops-backups
