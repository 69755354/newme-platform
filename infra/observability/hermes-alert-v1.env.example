# Install as /etc/hermes/observability/hermes-alert-v1.env.
# This file contains no secrets. The existing production notifier remains the transport.
HERMES_ALERT_STATE_DIR=/home/ubuntu/.local/state/hermes-alert-v1
HERMES_ALERT_THRESHOLD=2
HERMES_ALERT_NOTIFIER=/opt/hermes-scripts/observability/hermes-alert-notifier-v1.sh
HERMES_ALERT_LIBRARY=/opt/hermes-scripts/observability/hermes-alert.sh
