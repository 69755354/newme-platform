[Unit]
Description=NewMe monthly restore drill into a throwaway local PostgreSQL 17 (socket only)
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/libexec/newme/newme-restore-drill.sh
Environment=BACKUP_LIB=/usr/local/libexec/newme/newme-backup-lib.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/root/claude-ops-backups
