[Unit]
Description=Every 5 minutes: push OS changes to the Meta IDs sheet, Home-owners column X and the NAS spool
# STATUS: after-flag. Template, not installed. Enable only after OS_DRIVE_SYNC_ENABLED=true is set in
# /etc/newme/os-drive-sync.env and Sam has agreed; see docs/s28-drive-nas-sync.md.

[Timer]
OnCalendar=*-*-* *:0/5:00
RandomizedDelaySec=20
AccuracySec=10s

[Install]
WantedBy=timers.target
