[Unit]
Description=NewMe WhatsApp alert for failed unit %i

[Service]
Type=oneshot
User=root
# The failed unit's name is part of %i (for example newme-cron-daily-reminder), which is also the
# alert key the unit's success path later uses to send the recovery message.
ExecStart=/usr/local/libexec/newme/newme-whatsapp-alert.sh %i failure "systemd unit %i ended in failure (journalctl -u newme-cron@... on the server)"
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=-/var/lib/newme-alerts
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
