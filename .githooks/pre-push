#!/bin/bash
# 🔴 PRE-PUSH HOOK — CRM Deploy Gate + Chain Integrity + GLM CP Provenance Check
# v3: added hook chain self-verification + commit provenance check
set -e

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
MANIFEST="$HOOK_DIR/manifest.json"
MY_HASH=$(sha256sum "$0" | cut -d' ' -f1)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# ═══════════════════════════════════════════
# BARRIER 0: Hook Chain Integrity
# ═══════════════════════════════════════════
echo "═══════════════════════════════════════════"
echo "  🔴 Hook Chain Integrity Check"
echo "═══════════════════════════════════════════"

# Self check
STORED_HASH=$(python3 -c "import json;print(json.load(open('$MANIFEST'))['hooks']['pre-push'])" 2>/dev/null || echo "")
if [ -n "$STORED_HASH" ] && [ "$MY_HASH" != "$STORED_HASH" ]; then
    echo -e "${RED}🔴 PRE-PUSH HOOK TAMPERED — Run 'scripts/install-hooks.sh --force'${NC}"
    exit 1
fi

# Check all sibling hooks
ALL_OK=true
for hook in pre-commit commit-msg; do
    EXPECTED=$(python3 -c "import json;print(json.load(open('$MANIFEST'))['hooks'].get('$hook',''))" 2>/dev/null || echo "")
    if [ -n "$EXPECTED" ] && [ -f "$HOOK_DIR/$hook" ]; then
        ACTUAL=$(sha256sum "$HOOK_DIR/$hook" | cut -d' ' -f1)
        if [ "$ACTUAL" != "$EXPECTED" ]; then
            echo -e "${RED}🔴 Sibling hook '$hook' has been tampered with!${NC}"
            echo -e "${RED}   Expected: $EXPECTED${NC}"
            echo -e "${RED}   Actual:   $ACTUAL${NC}"
            ALL_OK=false
        fi
    fi
done

if [ "$ALL_OK" = false ]; then
    echo -e "${RED}❌ Hook chain integrity FAILED. Run 'scripts/install-hooks.sh --force'${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Hook chain integrity: PASS${NC}"

# ═══════════════════════════════════════════
# BARRIER -1: Commit Provenance (GLM CP check)
# ═══════════════════════════════════════════
echo ""
echo "── [BARRIER -1] Commit Provenance Check ──"

# Get the range of commits being pushed
# stdin format: <local-ref> <local-sha> <remote-ref> <remote-sha>
ZERO_SHA="0000000000000000000000000000000000000000"
HAS_CODE_COMMITS=false

while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
        continue  # Deleting a branch, skip
    fi
    
    # Determine commit range
    if [ "$REMOTE_SHA" = "$ZERO_SHA" ]; then
        RANGE="${LOCAL_SHA}"  # New branch, check all commits reachable
    else
        RANGE="${REMOTE_SHA}..${LOCAL_SHA}"
    fi
    
    # Check each commit in the range for code files AND [GLM-CP] marker
    for COMMIT in $(git rev-list "$RANGE" 2>/dev/null); do
        COMMIT_MSG=$(git log --format=%B -n1 "$COMMIT")
        HAS_MARKER=false
        if echo "$COMMIT_MSG" | grep -q '\[GLM-CP\]'; then
            HAS_MARKER=true
        fi
        
        # Check if this commit modifies code files
        CODE_FILES=$(git diff-tree --no-commit-id -r --name-only --diff-filter=ACM "$COMMIT" 2>/dev/null | grep -E '\.(ts|tsx|js|jsx|py|css|scss|less)$' || true)
        
        if [ -n "$CODE_FILES" ] && [ "$HAS_MARKER" = false ]; then
            echo -e "${RED}❌ Commit $COMMIT modifies code files but missing [GLM-CP] marker${NC}"
            echo "   Files:"
            echo "$CODE_FILES" | sed 's/^/     • /'
            HAS_CODE_COMMITS=true
        fi
    done
done

if [ "$HAS_CODE_COMMITS" = true ]; then
    echo ""
    echo -e "${RED}═══ BLOCKED: Code commits without GLM CP provenance ═══${NC}"
    echo -e "${RED}  v4 不能直接改代码。所有代码修改必须走 GLM 5.2 CP。${NC}"
    echo -e "${RED}  需要标记 [GLM-CP] 在 commit message 中。${NC}"
    echo ""
    echo -e "${YELLOW}  修复方式：${NC}"
    echo -e "${YELLOW}    git rebase -i 每个 commit，在 message 中加入 [GLM-CP]${NC}"
    echo -e "${YELLOW}    或 squash 这些 commit 后重新提交${NC}"
    exit 1
fi
echo -e "${GREEN}✅ All commits have valid provenance${NC}"

# ═══════════════════════════════════════════
# BARRIER 0.5: Existing regression + plan gates
# ═══════════════════════════════════════════
echo ""
echo "── [BARRIER 0.5] Regression Gate ──"

REGRESSION_SCRIPT="$HOME/.hermes/scripts/crm-regression.py"
STATE_FILE="$HOME/.hermes/state.json"
PLANS_DIR="$HOME/.hermes/plans"
PUSH_COUNTER="$HOME/.hermes/push-counter.json"

# ── Push Counter ──
if [ ! -f "$PUSH_COUNTER" ]; then
    echo '{"count":0,"last_full_date":"","full_regression_count":0}' > "$PUSH_COUNTER"
fi

COUNT=$(python3 -c "import json;print(json.load(open('$PUSH_COUNTER')).get('count',0))")
COUNT=$((COUNT + 1))
python3 -c "
import json
c = json.load(open('$PUSH_COUNTER'))
c['count'] = $COUNT
json.dump(c, open('$PUSH_COUNTER','w'), indent=2)
"
DOW=$(date +%u)
LAST_FULL_DATE=$(python3 -c "import json;print(json.load(open('$PUSH_COUNTER')).get('last_full_date',''))")

FORCE_FULL=false
if [ $((COUNT % 10)) -eq 0 ]; then
    FORCE_FULL=true
    REASON="Push #$COUNT (10th interval)"
elif [ "$DOW" = "5" ] && [ "$LAST_FULL_DATE" != "$(date +%Y-%m-%d)" ]; then
    FORCE_FULL=true
    REASON="Friday drift check ($(date +%Y-%m-%d))"
fi

if $FORCE_FULL; then
    echo -e "${YELLOW}[DRIFT PROTECTION] $REASON — forcing full regression${NC}"
    python3 -c "
import json
c = json.load(open('$PUSH_COUNTER'))
c['last_full_date'] = '$(date +%Y-%m-%d)'
c['full_regression_count'] = c.get('full_regression_count',0) + 1
json.dump(c, open('$PUSH_COUNTER','w'), indent=2)
"
    FULL_FLAG="--full"
else
    FULL_FLAG=""
    echo "Push #$COUNT | Drift check: not triggered"
fi

# ── Barrier 0: Regression ──
REGRESSION_OUTPUT=$(python3 "$REGRESSION_SCRIPT" 2>&1)
REGRESSION_EXIT=$?

if [ $REGRESSION_EXIT -ne 0 ]; then
    echo -e "${RED}[SYSTEM ERROR] 缺少客观测试屏障，禁止部署${NC}"
    echo "$REGRESSION_OUTPUT" | tail -20
    if $FORCE_FULL; then
        python3 -c "
import json, os, fcntl
mf = '$HOME/.hermes/metrics.json'
lk = mf + '.lock'
fd = os.open(lk, os.O_CREAT | os.O_RDWR)
fcntl.flock(fd, fcntl.LOCK_EX)
try:
    try: m = json.load(open(mf))
    except: m = {}
    m['friday_failures'] = m.get('friday_failures',0) + 1
    json.dump(m, open(mf,'w'), indent=2)
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
" 2>/dev/null
    fi
    exit 1
fi
echo -e "${GREEN}Regression: PASS${NC}"

# ── Metrics ──
python3 -c "
import json, os, fcntl
mf = '$HOME/.hermes/metrics.json'
lk = mf + '.lock'
fd = os.open(lk, os.O_CREAT | os.O_RDWR)
fcntl.flock(fd, fcntl.LOCK_EX)
try:
    try: m = json.load(open(mf))
    except: m = {}
    m['total_push_runs'] = m.get('total_push_runs',0) + 1
    if $FORCE_FULL: m['friday_runs'] = m.get('friday_runs',0) + 1
    json.dump(m, open(mf,'w'), indent=2)
finally:
    fcntl.flock(fd, fcntl.LOCK_UN)
    os.close(fd)
" 2>/dev/null

# ── Barrier 1: Plan State Machine ──
echo ""
echo "── [BARRIER 1] Plan State Machine ──"

ACTIVE_PLAN=""
for plan in "$PLANS_DIR"/*.json; do
    [ -f "$plan" ] || continue
    plan_name=$(basename "$plan" .json)
    [ "$plan_name" = "_TEMPLATE" ] && continue
    status=$(python3 -c "import json; print(json.load(open('$plan')).get('status','draft'))" 2>/dev/null || echo "")
    if [ "$status" != "completed" ] && [ "$status" != "cancelled" ] && [ "$status" != "" ]; then
        ACTIVE_PLAN="$plan_name"
        break
    fi
done

if [ -n "$ACTIVE_PLAN" ]; then
    echo "Active plan: $ACTIVE_PLAN"
    STEP_REQUIRES_REG=$(python3 -c "
import json
plan = json.load(open('$PLANS_DIR/$ACTIVE_PLAN.json'))
for s in plan.get('steps', []):
    if s.get('status') == 'in_progress':
        print('true' if s.get('regression_required', True) else 'false')
        break
" 2>/dev/null || echo "true")
    if [ "$STEP_REQUIRES_REG" = "true" ]; then
        echo "Current step requires regression → satisfied"
    fi
else
    echo "No active plan — manual mode (regression enforced)"
fi

# ── Barrier 2: State Consistency ──
echo ""
echo "── [BARRIER 2] State Consistency ──"

if [ -f "$STATE_FILE" ]; then
    UNVERIFIED=$(python3 -c "
import json
state = json.load(open('$STATE_FILE'))
unverified = [k for k,v in state.get('entities',{}).items() if v.get('status')=='unverified']
print(len(unverified))
" 2>/dev/null || echo "0")
    ORPHANS=$(python3 -c "
import json
state = json.load(open('$STATE_FILE'))
orphans = [k for k,v in state.get('entities',{}).items() if v.get('status')=='unverified' and not v.get('plan_id')]
print(len(orphans))
" 2>/dev/null || echo "0")
    if [ "$UNVERIFIED" -gt 3 ]; then
        echo -e "${RED}WARNING: $UNVERIFIED entities unverified${NC}"
    else
        echo "OK ($UNVERIFIED unverified)"
    fi
    if [ "$ORPHANS" -gt 0 ]; then
        echo -e "${YELLOW}Orphan alert: $ORPHANS unverified with no plan_id${NC}"
    fi
fi

# ── Boundary 3: Perfect Zero Check before push ──
echo ""
echo "── [ZERO CHECK] Perfect zero verification ──"
if [ -f "$HOME/.hermes/scripts/run_agent.py" ]; then
    python3 "$HOME/.hermes/scripts/run_agent.py" --check-zero </dev/null 2>/dev/null
    ZERO_EXIT=$?
    if [ $ZERO_EXIT -ne 0 ]; then
        echo -e "${YELLOW}[WARNING] Zero drift detected — review state before pushing${NC}"
    fi
else
    echo "[SKIP] run_agent.py not found"
fi

echo ""
echo -e "${GREEN}══════ ALL BARRIERS PASSED — pushing... ══════${NC}"
exit 0
