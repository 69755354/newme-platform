{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://newme.ae/contracts/v4/work-item.schema.v1.json",
  "title":"NewMe V4 Work Item",
  "type":"object",
  "additionalProperties":false,
  "required":["work_item_id","dedupe_key","organization_id","vertical_key","location_id","owner_type","owner_id","queue","status","priority_band","title_key","reason_code","why_now","source_event_ids","aggregate","due_at","expires_at","primary_action","allowed_dispositions","required_capabilities","risk_level","policy_version","projection_version","updated_at"],
  "properties":{
    "work_item_id":{"type":"string","format":"uuid"},
    "dedupe_key":{"type":"string","minLength":8,"maxLength":240},
    "organization_id":{"type":"string","format":"uuid"},
    "vertical_key":{"enum":["platform","crm","real_estate","retail"]},
    "location_id":{"type":["string","null"],"format":"uuid"},
    "owner_type":{"enum":["user","role","team","unassigned"]},
    "owner_id":{"type":["string","null"],"format":"uuid"},
    "queue":{"enum":["my_work","team_command","approval","exception"]},
    "status":{"enum":["candidate","ready","in_progress","snoozed","approval_pending","blocked","completed","rejected","skipped","expired","withdrawn"]},
    "priority_band":{"enum":["P0","P1","P2","P3"]},
    "title_key":{"type":"string","minLength":1},
    "reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
    "why_now":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "source_event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","format":"uuid"}},
    "aggregate":{"type":"object","additionalProperties":false,"required":["type","id","version"],"properties":{"type":{"type":"string"},"id":{"type":"string","format":"uuid"},"version":{"type":"integer","minimum":1}}},
    "due_at":{"type":["string","null"],"format":"date-time"},
    "expires_at":{"type":["string","null"],"format":"date-time"},
    "primary_action":{"type":"string","minLength":1},
    "allowed_dispositions":{"type":"array","uniqueItems":true,"items":{"enum":["start","complete","snooze","skip","reassign","request_approval"]}},
    "required_capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "risk_level":{"enum":["L0","L1","L2","L3","L4"]},
    "policy_version":{"type":"string","minLength":1},
    "projection_version":{"type":"integer","minimum":1},
    "updated_at":{"type":"string","format":"date-time"}
  }
}
