#!/bin/bash
# Pre-commit C++ scope gate.
# Checks: [CODEX] marker present, changed files within manifest scope.
# Non-Codex commits skip this check (handled by deploy gate).

COMMIT_MSG=$(git log -1 --format=%s HEAD 2>/dev/null || echo "")

# Only enforce for Codex commits
if ! echo "$COMMIT_MSG" | grep -q '\[CODEX\]'; then
  exit 0
fi

TASK_ID=$(echo "$COMMIT_MSG" | grep -oP '\[task_[a-zA-Z0-9_-]+\]' | head -1 | tr -d '[]')
if [ -z "$TASK_ID" ]; then
  echo "🚫 [CODEX] commit requires [task_XXXXXXX] marker in commit message"
  exit 1
fi

MANIFEST=".hermes/delegations/${TASK_ID}.json"
if [ ! -f "$MANIFEST" ]; then
  echo "🚫 Manifest not found: $MANIFEST"
  exit 1
fi

# Check changed files
CHANGED=$(git diff --cached --name-only 2>/dev/null)
ALLOWED=$(python3 -c "import json; print(' '.join(json.load(open('$MANIFEST')).get('allowed_files',[])))" 2>/dev/null)
FORBIDDEN=$(python3 -c "import json; print(' '.join(json.load(open('$MANIFEST')).get('forbidden_files',[])))" 2>/dev/null)

for f in $CHANGED; do
  for fb in $FORBIDDEN; do
    if echo "$f" | grep -q "$fb"; then
      echo "🚫 Pre-commit BLOCKED: $f matches FORBIDDEN pattern $fb"
      exit 1
    fi
  done
  MATCHED=false
  for af in $ALLOWED; do
    if echo "$f" | grep -q "$af"; then MATCHED=true; break; fi
  done
  if ! $MATCHED; then
    echo "🚫 Pre-commit BLOCKED: $f not in manifest allowed_files"
    echo "   Manifest: $MANIFEST"
    echo "   Allowed: $ALLOWED"
    exit 1
  fi
done

echo "✅ Pre-commit scope OK: $TASK_ID"
exit 0
