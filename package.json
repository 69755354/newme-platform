{
  "name": "newme-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "bash -c 'if [ \"${FORCE_BUILD:-0}\" = \"1\" ]; then echo \"⚠️  FORCE_BUILD=1 set — bypassing production server guard\" >&2; elif systemctl is-active --quiet newme-platform.service 2>/dev/null; then echo \"❌ Production server is running! Use: npm run deploy (which auto-stops → builds → restarts) — or set FORCE_BUILD=1 to bypass this guard.\" >&2; exit 1; fi; next build'",
    "start": "next start",
    "lint": "eslint",
    "deploy": "bash scripts/deploy.sh",
    "check:schema-refs": "python3 scripts/check-schema-refs.py",
    "check:route-files": "bash scripts/check-route-files.sh",
    "check:smoke": "bash scripts/check-smoke.sh",
    "check:logs": "bash scripts/check-logs.sh",
    "check:release": "npm run check:schema-refs && npm run check:route-files && npm run check:smoke && npm run check:logs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@sentry/nextjs": "^10.62.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "posthog-js": "^1.386.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}