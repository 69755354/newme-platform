NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY — set in production env, not in .env.local
# META_PIXEL_ID, META_CAPI_ACCESS_TOKEN, and META_GRAPH_API_VERSION are
# required server-only production runtime settings managed in /etc/newme.
# Meta Lead Ads intake is disabled by default. See docs/meta-lead-ads-intake.md.
META_LEADGEN_ENABLED=false
# Server-only: META_LEADGEN_VERIFY_TOKEN, META_APP_SECRET, META_LEADS_ACCESS_TOKEN,
# META_LEADGEN_PAGE_IDS. Never put their values in this example file.
# WhatsApp observer is opt-in and disabled by default. See docs/whatsapp-pilot.md.
WHATSAPP_PILOT_ENABLED=false
# Server-only secrets: WHATSAPP_APP_SECRET, WHATSAPP_WEBHOOK_VERIFY_TOKEN,
# WHATSAPP_PILOT_CONTACT_SALT. Never put their values in this example file.
# Review tools never send from a production number. Explicitly authorised,
# server-only sandbox access has a fixed activation window of at most 24 hours.
WHATSAPP_REVIEW_TOOLS_ENABLED=false
# Server-only runtime settings: WHATSAPP_REVIEW_ACCESS_TOKEN,
# WHATSAPP_REVIEW_TOOLS_FROM and WHATSAPP_REVIEW_TOOLS_UNTIL (UTC ISO seconds).
