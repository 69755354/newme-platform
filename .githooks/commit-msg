#!/bin/bash
# 🔴 COMMIT-MSG HOOK — [GLM-CP] tag enforcement
# Second gate: ensures final commit message contains [GLM-CP] when code files are staged
# Part of NewMe hook chain
set -e

HOOK_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
MANIFEST="$HOOK_DIR/manifest.json"
MY_HASH=$(sha256sum "$0" | cut -d' ' -f1)

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

# Self-integrity
STORED_HASH=$(python3 -c "import json;print(json.load(open('$MANIFEST'))['hooks']['commit-msg'])" 2>/dev/null || echo "")
if [ -n "$STORED_HASH" ] && [ "$MY_HASH" != "$STORED_HASH" ]; then
    echo -e "${RED}🔴 COMMIT-MSG HOOK TAMPERED — Run 'scripts/install-hooks.sh --force'${NC}"
    exit 1
fi

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Only enforce if there are code files staged
STAGED_CODE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|py|css|scss|less)$' || true)

if [ -z "$STAGED_CODE" ]; then
    exit 0  # No code files, no enforcement needed
fi

# Check for marker — accept [CODEX] or [OPENCODE] only
if ! echo "$COMMIT_MSG" | grep -qE '\[(CODEX|OPENCODE)\]'; then
    echo ""
    echo -e "${RED}═══════════════════════════════════════════${NC}"
    echo -e "${RED}  ❌ [CODEX] or [OPENCODE] marker required in commit message${NC}"
    echo -e "${RED}     代码修改必须通过 Codex 或 OpenCode${NC}"
    echo -e "${RED}═══════════════════════════════════════════${NC}"
    echo ""
    echo "Affected files:"
    echo "$STAGED_CODE" | sed 's/^/  • /'
    echo ""
    exit 1
fi

exit 0
