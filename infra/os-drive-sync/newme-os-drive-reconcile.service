[Unit]
Description=NewMe nightly OS vs Google Sheets vs NAS reconcile (read-only report)
# STATUS: after-flag. Read-only; install together with newme-os-drive-sync.timer.
After=network-online.target
Wants=network-online.target
# Exits non-zero when drift is found; the report is in /var/lib/newme-os-drive-sync/reports/.
OnFailure=newme-backup-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/newme/current
EnvironmentFile=/etc/newme/newme-runtime.env
EnvironmentFile=-/etc/newme/os-drive-sync.env
Environment=GOOGLE_SA_FILE=/etc/newme/google-sheets-sa.json
# flock: one run at a time (the lock lives in the state directory; /run is read-only under ProtectSystem=strict)
ExecStart=/usr/bin/flock -w 120 /var/lib/newme-os-drive-sync/run.lock /usr/bin/node scripts/os-drive-nas-sync.mjs --reconcile
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/newme-os-drive-sync
StateDirectory=newme-os-drive-sync
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Nice=10
